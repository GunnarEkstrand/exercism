pub fn score(x: Float, y: Float) -> Int {
  case x, y {
    x, y if { -0.5 <=. x && x <=. 0.5 } && { -0.5 <=. y && y <=. 0.5 } -> 10
    x, y if { -2.5 <=. x && x <=. 2.5 } && { -2.5 <=. y && y <=. 2.5 } -> 5
    x, y if { -5.0 <=. x && x <=. 5.0 } && { -5.0 <=. y && y <=. 5.0 } -> 1
    _, _ -> 0
  }
}
